# ==================== 9ROUTER (Nguồn AI chính) ====================
# 9Router là proxy AI chạy trên máy admin, cung cấp ~100 lượt miễn phí
# Khi 9Router lỗi/tắt → hệ thống tự động chuyển sang Gemini dự phòng
#
# CÓ 2 CÁCH CẤU HÌNH (chọn 1):
#
# CÁCH 1: Biến môi trường RUNTIME (khuyên dùng, dùng trên Vercel)
# → Đặt trên Vercel Dashboard > Settings > Environment Variables
# → Admin thay đổi → TẤT CẢ giáo viên nhận config mới ngay (không redeploy)
# → Dùng tên KHÔNG có prefix VITE_ (đọc tại runtime qua serverless function)
ROUTER_URL=https://rb8p2e6.abc-tunnel.us/v1
ROUTER_KEY=sk-6efbc48676a666d9-ik40k6-1fedb3d3
ROUTER_MODEL=gemini-2.5-flash
#
# CÁCH 2: Biến môi trường BUILD TIME (dùng cho development local)
# → Đặt trong file .env.local
# → Baked vào code lúc build, cần rebuild/redeploy khi thay đổi
VITE_9ROUTER_URL=https://rb8p2e6.abc-tunnel.us/v1
VITE_9ROUTER_KEY=sk-6efbc48676a666d9-ik40k6-1fedb3d3
VITE_9ROUTER_MODEL=gemini-2.5-flash

# ==================== GEMINI (Nguồn AI dự phòng) ====================
# Gemini API Key - Lấy miễn phí tại: https://aistudio.google.com/app/apikey
# Giáo viên cũng có thể nhập key riêng trên giao diện web (ưu tiên cao nhất)
VITE_GEMINI_API_KEY=

# ==================== GOOGLE OAUTH ====================
# Google OAuth Client ID - Để đăng nhập Google & lưu vào Google Docs
# Tạo tại: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=
